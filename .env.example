# Copy to .env and fill in. Never commit .env.

CODMON_EMAIL=your-codmon-email@example.com
CODMON_PASSWORD=your-codmon-password

HUCKLEBERRY_EMAIL=your-huckleberry-email@example.com
HUCKLEBERRY_PASSWORD=your-huckleberry-password

# IANA timezone (default Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# When true, plan events are printed but nothing is written to Huckleberry.
DRY_RUN=true

# Codmon transport: 'api' (direct JSON API, no browser) or 'browser' (Playwright fallback)
CODMON_TRANSPORT=api

# Whether to sync the reported body temperatures into Huckleberry.
SYNC_TEMPERATURE=true

# Child to sync (name/kana/id); matches both Codmon and Huckleberry.
# Default: first child on each side. Use a token shared by both the Codmon
# child name and the Huckleberry nickname, e.g. CHILD=BABY.
#CHILD=BABY

# Before writing, skip an event if Huckleberry already has a same-type event
# within this many minutes of the planned time. Default 15.
#DEDUP_WINDOW_MINUTES=15

# Directory for sync state and introspect artifacts (default: data/)
DATA_DIR=data

# Debug/diagnostics
HEADLESS=true